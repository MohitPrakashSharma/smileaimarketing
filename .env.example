# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
# Public address printed in customer PDFs (defaults to APP_BASE_URL unless that is a localhost/private address)
REPORT_PUBLIC_BASE_URL=
# Private storage for generated v2 report PDFs (outside public/; shared web+worker volume in production)
REPORTS_PRIVATE_DIR=
APP_BASE_URL=http://localhost:3000

# Core (required)
DATABASE_URL=postgresql://smileai:smileai_password@localhost:5435/smileai_marketing
REDIS_URL=redis://localhost:6375
JWT_SECRET=
CRON_SECRET=
WEBHOOK_SECRET=

# Audit engine
CRAWL_V2=true
AUDIT_EXECUTION=inline
AUDIT_MAX_PAGES=40
AUDIT_MAX_PAGES_ADMIN=150
AUDIT_MAX_DURATION_MS=90000

# Performance (Google PageSpeed Insights — free; key optional, raises quota)
AUDIT_PSI_ENABLED=true
PAGESPEED_API_KEY=
AUDIT_PSI_MAX_PAGES=4
AUDIT_PSI_MAX_PAGES_ADMIN=5

# AI content intelligence (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=
AUDIT_AI_ENABLED=true
AUDIT_AI_MAX_PAGES=5
AUDIT_AI_MAX_PAGES_ADMIN=8

# Optional integrations (leave blank to keep disabled)
GOOGLE_PLACES_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
APOLLO_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_SEND_MODE=test
DATA_MODE=test
