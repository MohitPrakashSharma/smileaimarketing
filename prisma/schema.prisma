datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  SALES
}

enum CampaignStatus {
  DRAFT
  READY
  DISCOVERING
  PROCESSING
  REVIEW_REQUIRED
  READY_FOR_OUTREACH
  ACTIVE
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
}

enum BusinessStatus {
  DISCOVERED
  QUALIFIED
  AUDITING
  AUDITED
  OUTREACH_PENDING
  OUTREACH_ACTIVE
  CONVERTED
  DISQUALIFIED
}

enum AuditStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Which analysis engine produced an audit — reports render according to this.
enum AuditEngine {
  LEGACY_V1
  CRAWL_V2
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  OPPORTUNITY
}

enum FindingPillar {
  TECHNICAL
  CONTENT
  SEARCH
  LOCAL
  CONVERSION
  PERFORMANCE
}

// Provenance of a finding — a reader must always be able to tell a measured
// fact from an inference (plan §2A "AI labeling").
enum EvidenceKind {
  MEASURED
  DETERMINISTIC_FINDING
  AI_RECOMMENDATION
  AI_INFERRED_OPPORTUNITY
  UNKNOWN
}

enum CheckStatus {
  PASS
  FAIL
  SKIPPED
  INFO
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  OPENED
  CLICKED
  REPLIED
}

enum AppointmentType {
  ONLINE
  IN_PERSON
}

enum AppointmentStatus {
  REQUESTED
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// A consultation booked from the "Request Full Technical Report" link. The
// report is never sent automatically: PENDING → our team CONTACTED the lead →
// the team DELIVERED the PDF by hand. Null on ordinary bookings.
enum TechnicalReportStatus {
  PENDING
  CONTACTED
  DELIVERED
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  name                 String
  passwordHash         String
  role                 UserRole              @default(SALES)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  activities           SalesActivity[]
  googleCalendarTokens GoogleCalendarToken[]

  @@index([email])
}

model Campaign {
  id   String @id @default(uuid())
  name String

  // Step 1: Target market
  country  String  @default("US")
  state    String?
  city     String
  category String

  // Step 2: Lead criteria
  maxBusinesses           Int     @default(10)
  minReviewCount          Int?
  websiteRequired         Boolean @default(true)
  excludeChains           Boolean @default(false)
  excludeExistingContacts Boolean @default(false)

  // Step 3: Audit configuration
  keywords          String[] @default([])
  competitorCount   Int      @default(3)
  dataFreshnessDays Int      @default(30)
  dataProvider      String   @default("MOCK") // "MOCK" | "TEST_PROVIDER" | "GOOGLE_PLACES" | "DATAFORSEO"

  // Step 4: Outreach configuration
  outreachDailyLimit Int     @default(8)
  testMode           Boolean @default(true)

  status      CampaignStatus  @default(DRAFT)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  businesses  Business[]
  sequences   EmailSequence[]

  @@index([status])
  @@index([city])
  @@index([createdAt])
}

model Business {
  id               String         @id @default(uuid())
  campaignId       String?
  campaign         Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name             String
  normalizedName   String? // lowercased, punctuation-stripped — used for fuzzy dedup
  website          String
  normalizedDomain String? // lowercased host, no protocol/www/trailing slash — used for dedup
  address          String?
  city             String
  state            String?
  country          String         @default("US")
  phone            String?
  category         String
  status           BusinessStatus @default(DISCOVERED)
  leadSource       String         @default("campaign_outreach") // "campaign_outreach" | "website_audit"
  opportunityScore Int            @default(0)

  // Discovery provider metadata
  googlePlaceId     String?   @unique
  latitude          Float?
  longitude         Float?
  rating            Float?
  reviewCount       Int?
  providerSource    String? // "TEST_PROVIDER" | "GOOGLE_PLACES" | "DATAFORSEO" | "MANUAL" | "SEED"
  rawProviderRef    Json? // opaque provider payload — never exposed to the public frontend
  firstDiscoveredAt DateTime? @default(now())
  lastCheckedAt     DateTime?

  // Acquisition attribution — captured once at creation from the anonymous visitor's
  // first-touch cookie, never updated afterwards (last-touch lives per-event instead).
  visitorId             String?
  firstTouchSource      String?
  firstTouchMedium      String?
  firstTouchCampaign    String?
  firstTouchContent     String?
  firstTouchTerm        String?
  firstTouchLandingPage String?
  firstTouchReferrer    String?

  // Manual revenue close-out — no billing/invoicing integration exists to derive this from.
  dealValueCents Int?
  wonAt          DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contacts         Contact[]
  audits           Audit[]
  appointments     Appointment[]
  salesActivities  SalesActivity[]
  engagementEvents EngagementEvent[]

  @@unique([website, city])
  @@index([campaignId])
  @@index([status])
  @@index([city])
  @@index([normalizedDomain])
  @@index([createdAt])
  @@index([visitorId])
  @@index([firstTouchCampaign])
}

model Contact {
  id             String          @id @default(uuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String
  phone          String?
  role           String?
  source         String          @default("MANUAL") // "APOLLO" | "WEBSITE" | "MANUAL" | "SELF_SERVE" — where this contact was actually found
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emailMessages  EmailMessage[]
  appointments   Appointment[]
  consentRecords ConsentRecord[]

  @@unique([businessId, email])
  @@index([email])
}

model Audit {
  id               String            @id @default(uuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publicToken      String            @unique @default(uuid()) // Secure non-sequential URL token
  status           AuditStatus       @default(PENDING)
  score            Int               @default(0)
  summaryText      String? // Fact-based AI / deterministic audit summary
  pdfStatus        String            @default("NOT_REQUESTED") // "NOT_REQUESTED" | "QUEUED" | "GENERATING" | "READY" | "FAILED"
  pdfUrl           String?
  pdfGeneratedAt   DateTime?
  viewCount        Int               @default(0)
  lastViewedAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  results          AuditResult[]
  competitorGaps   Competitor[]
  engagementEvents EngagementEvent[]

  // --- Audit engine v2 (lib/audit) ---
  engine             AuditEngine           @default(LEGACY_V1)
  configJson         Json? // { maxPages, maxDurationMs, trigger: "self_serve" | "admin" | "campaign" }
  progressJson       Json? // stage list + counters, updated while RUNNING (see lib/audit/progress.ts)
  startedAt          DateTime?
  completedAt        DateTime?
  errorMessage       String?
  // Pillar scores are only written once the crawl is complete enough to be reliable; null = not measured.
  overallScore       Int?
  technicalScore     Int?
  contentScore       Int?
  searchScore        Int?
  localScore         Int?
  performanceScore   Int? // Phase 2A: PageSpeed-based pillar; null = not measured
  scoreBreakdownJson Json? // per pillar: [{ checkId, weight, pageShare, penalty }] — the ledger behind every score
  crawlStatsJson     Json? // { pagesDiscovered, pagesCrawled, pagesSkipped, robotsBlocked, durationMs, budgetHit }
  summaryJson        Json? // reserved for Phase 3 AI/template executive summary
  pages              AuditPage[]
  findings           AuditFinding[]
  checkResults       AuditCheckResult[]
  performance        AuditPerformance[]
  aiAnalyses         AuditAiPageAnalysis[]
  appointments       Appointment[]

  @@index([businessId])
  @@index([publicToken])
  @@index([status])
}

// One row per URL the v2 crawler fetched (or tried to). Everything the checks
// look at lives here so a finding can always point back to its evidence.
model AuditPage {
  id                 String   @id @default(uuid())
  auditId            String
  audit              Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url                String
  finalUrl           String?
  statusCode         Int?
  fetchError         String?
  redirectChainJson  Json? // ["http://a", "https://a", "https://www.a"]
  contentType        String?
  depth              Int? // click depth via links; null = sitemap-only, never linked
  discoveredVia      String? // "seed" | "sitemap" | "link"
  parentUrl          String?
  inSitemap          Boolean  @default(false)
  fetchMs            Int?
  htmlBytes          Int?
  isHttps            Boolean?
  mixedContent       Boolean?
  title              String?
  metaDescription    String?
  canonical          String?
  robotsMeta         String?
  xRobotsTag         String?
  indexable          Boolean?
  lang               String?
  charset            String?
  hasDoctype         Boolean?
  viewport           Boolean?
  h1Json             Json?
  headingCountsJson  Json? // { h1: 1, h2: 4, h3: 9 }
  wordCount          Int?
  textHash           String? // sha1 of normalized body text, for duplicate detection
  imagesTotal        Int?
  imagesMissingAlt   Int?
  imagesNoDimensions Int?
  internalLinks      Int?
  externalLinks      Int?
  schemaTypesJson    Json?
  schemaErrors       Int?
  hasTelLink         Boolean?
  hasForm            Boolean?
  hasPrimaryCta      Boolean?
  ogTagsPresent      Boolean?
  headersJson        Json? // security-relevant response headers only
  factsJson          Json? // everything else the parser kept (link samples, image samples…)
  fetchedAt          DateTime @default(now())

  @@unique([auditId, url])
  @@index([auditId])
}

// Atomic check ledger: one row per check per audit. The scores are computed
// from these rows and nothing else, so every lost point is traceable.
model AuditCheckResult {
  id                String           @id @default(uuid())
  auditId           String
  audit             Audit            @relation(fields: [auditId], references: [id], onDelete: Cascade)
  checkId           String // "tech.https.missing"
  pillar            FindingPillar
  status            CheckStatus
  severity          FindingSeverity?
  affectedPageCount Int              @default(0)
  pageShare         Float            @default(0)
  weight            Int              @default(0)
  penalty           Float            @default(0)
  evidenceJson      Json? // sample of affected pages with detected/expected values
  reason            String? // why SKIPPED / INFO
  createdAt         DateTime         @default(now())

  @@unique([auditId, checkId])
  @@index([auditId, pillar])
}

// Client-facing findings: grouped from check results, carry evidence and
// both owner-level and developer-level guidance.
model AuditFinding {
  id                   String          @id @default(uuid())
  auditId              String
  audit                Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  findingKey           String // group key, e.g. "titles_and_descriptions" or "page:/services"
  checkIdsJson         Json // underlying check ids
  pillar               FindingPillar
  section              String // report section code: "B1", "C4", …
  severity             FindingSeverity
  title                String
  affectedUrlsJson     Json // up to 50 urls
  affectedPageCount    Int
  evidenceJson         Json // per check: detected/expected + page samples
  detectedValue        String?
  expectedValue        String?
  whyItMatters         String
  recommendedFix       String
  developerDetailsJson Json? // [{ checkId, title, detected, expected, fix, urls }]
  impact               Int // 1–5
  effort               Int // 1–5
  confidence           Int // 0–100
  priorityScore        Float
  owner                String // "owner" | "developer" | "agency"
  // Phase 2A provenance — null on Phase-1 rows means DETERMINISTIC_FINDING from the crawler.
  evidenceKind         EvidenceKind?
  source               String? // "crawler" | "pagespeed" | "openai"
  device               String? // "mobile" | "desktop" | null (not device-specific)
  metric               String? // e.g. "LCP", "INP", "CLS", "performance_score"
  createdAt            DateTime        @default(now())

  @@index([auditId, pillar])
  @@index([auditId, priorityScore])
}

// One PageSpeed Insights run: a representative URL × strategy. Field (CrUX)
// and lab (Lighthouse) data are kept apart; diagnostics are normalized and
// capped — never the raw response.
model AuditPerformance {
  id                String    @id @default(uuid())
  auditId           String
  audit             Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url               String
  strategy          String // "mobile" | "desktop"
  pageType          String? // "home" | "service" | "location" | "conversion" | "content" | "other"
  selectionReason   String?
  status            String // "ok" | "unavailable"
  error             String?
  errorCode         String? // "timeout" | "rate_limited" | "rejected" | "malformed" | "http_error" | "network"
  fieldJson         Json? // normalized CrUX metrics (or { available: false })
  labJson           Json? // normalized Lighthouse metrics + performance score
  diagnosticsJson   Json? // normalized audits: [{ id, title, score, displayValue, numericValue, savingsMs, savingsBytes, items[≤5] }]
  lcpElementJson    Json? // { snippet, url } when Lighthouse reports the LCP element
  categoriesJson    Json? // Google's other Lighthouse categories for this run: { accessibility, bestPractices, seo } → { score 0–100, passed, applicable, failed[] } (null = not returned)
  agenticJson       Json? // Lighthouse 13 "Agentic Browsing": { score, passed, applicable, checks[] } — presented as passed/applicable, never as a percentage
  screenshotJson    Json? // Lighthouse's own screenshot of the finished page, from the same PSI response: { dataUri, mimeType, width, height, bytes }. Homepage rows only.
  lighthouseVersion String?
  analysisUtc       DateTime?
  fetchedAt         DateTime  @default(now())

  @@unique([auditId, url, strategy])
  @@index([auditId])
}

// One OpenAI content-intelligence analysis per selected page. The compact
// evidence we sent and the validated structured output are both kept so the
// result is reproducible and the report never re-calls the API.
model AuditAiPageAnalysis {
  id              String   @id @default(uuid())
  auditId         String
  audit           Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url             String
  pageType        String?
  selectionReason String?
  status          String // "ok" | "unavailable" | "skipped"
  error           String?
  errorCode       String? // "no_api_key" | "model_unavailable" | "auth" | "rate_limited" | "timeout" | "api_error" | "invalid_output" | "low_confidence" | "empty_content"
  model           String?
  promptVersion   String?
  inputTokens     Int?
  outputTokens    Int?
  evidenceJson    Json? // the normalized page evidence sent to the model (no secrets, no raw HTML)
  resultJson      Json? // validated structured output (after claim scrubbing)
  scrubbedJson    Json? // sentences removed by the unsupported-claim filter, for auditing
  createdAt       DateTime @default(now())

  @@unique([auditId, url])
  @@index([auditId])
}

model AuditResult {
  id           String   @id @default(uuid())
  auditId      String
  audit        Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category     String // e.g., "LOCAL_VISIBILITY", "WEBSITE_QUALITY", "CONVERSION", "REPUTATION"
  score        Int // Category specific score
  findingsJson Json // Structured facts e.g. { speed: 45, ssl: false }
  detailsJson  Json? // Copy and human recommendations
  createdAt    DateTime @default(now())

  @@index([auditId])
}

model Competitor {
  id        String   @id @default(uuid())
  auditId   String
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  name      String
  website   String?
  rank      Int // V1: local-pack position. Local comparison (v2): discovery order only — never shown as a ranking.
  mapScore  Int?
  createdAt DateTime @default(now())

  // --- Local comparison (lib/audit/competitors) — all nullable; V1 rows leave them empty ---
  source          String? // "GOOGLE_PLACES" — where the business was identified
  placeId         String? // Google place id (the one Places field that may be stored indefinitely)
  address         String?
  relevance       String? // why it was chosen, e.g. "pediatric dentist · Newmarket" (from Places types + locality)
  discoveredAt    DateTime?
  measuredAt      DateTime?
  measurementJson Json? // our own PageSpeed measurement of the competitor homepage (mobile) — see CompetitorMeasurement

  @@index([auditId])
}

model EmailSequence {
  id         String      @id @default(uuid())
  campaignId String
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  steps      EmailStep[]
}

model EmailStep {
  id           String         @id @default(uuid())
  sequenceId   String
  sequence     EmailSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepDay      Int // Day offset e.g., 0, 3, 7, 12
  subject      String
  bodyTemplate String // Markdown or HTML template containing replacement variables
  messages     EmailMessage[]
}

model EmailMessage {
  id            String      @id @default(uuid())
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stepId        String
  step          EmailStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status        EmailStatus @default(QUEUED)
  scheduledTime DateTime? // When outreach is scheduled to be sent

  messageId String? // External email service ID
  sentAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  events    EngagementEvent[]

  @@index([contactId])
  @@index([status])
  @@index([scheduledTime])
  @@index([messageId])
}

model EngagementEvent {
  id             String        @id @default(uuid())
  emailMessageId String?
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  businessId     String?
  business       Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  auditId        String?
  audit          Audit?        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  eventType      String // "campaign_created", "business_discovered", "audit_completed", "OPEN", "CLICK", "REPORT_VIEW", "PDF_DOWNLOAD", "BOOKING_REQUESTED"
  linkClicked    String?
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime      @default(now())

  // Full-funnel attribution — added for the analytics tracking abstraction (lib/analytics.ts).
  // All nullable/additive: pre-existing rows and call sites are unaffected.
  eventId     String? @unique // caller-generated UUID, for cross-client/GA4 dedupe
  visitorId   String? // anonymous cookie id — present on pre-lead website-funnel events
  sessionId   String?
  path        String?
  referrer    String?
  utmSource   String? // last-touch snapshot in effect when this specific event fired
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  properties  Json? // allowlisted safe properties only — never PII, enforced in lib/analytics.ts

  @@index([emailMessageId])
  @@index([businessId])
  @@index([auditId])
  @@index([eventType])
  @@index([visitorId])
  @@index([utmCampaign])
}

model Appointment {
  id               String            @id @default(uuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type             AppointmentType
  status           AppointmentStatus @default(REQUESTED)
  scheduledTime    DateTime
  durationMinutes  Int               @default(15)
  address          String? // For offline in-person visits
  preferredWindow  String? // Muted text for timing range
  notes            String?
  salesBriefingUrl String? // URL link to generated PDF brief
  googleEventId    String?
  meetLink         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // The audit this booking came from (report sidebar, consultation page with a
  // publicToken, or the technical-report request link). Null for cold bookings.
  auditId                    String?
  audit                      Audit?                 @relation(fields: [auditId], references: [id], onDelete: SetNull)
  technicalReportStatus      TechnicalReportStatus? // set only when the booking asked for the full technical report
  technicalReportRequestedAt DateTime?

  @@index([businessId])
  @@index([contactId])
  @@index([scheduledTime])
  @@index([status])
  @@index([auditId])
}

model SalesActivity {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // "NOTE", "CALL", "EMAIL", "MEETING"
  content    String
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([userId])
}

model SuppressionRecord {
  id        String   @id @default(uuid())
  email     String   @unique
  domain    String? // Exclude entire clinic domains if requested
  reason    String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([domain])
}

model ConsentRecord {
  id             String   @id @default(uuid())
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  ipAddress      String?
  consentType    String // e.g. "MARKETING_EMAIL", "COMMUNICATION"
  consentGranted Boolean  @default(true)
  timestamp      DateTime @default(now())

  @@index([contactId])
}

// One shared Google account connected for Calendar/Meet — not per-admin-user.
// A single row, upserted at id "default" each time someone (re)connects.
model GoogleCalendarToken {
  id                 String   @id @default("default")
  googleAccountEmail String?
  accessToken        String
  refreshToken       String
  expiresAt          DateTime
  scope              String
  connectedByUserId  String?
  connectedByUser    User?    @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
